{
  "name": "@workspace/contracts",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "compile": "npx hardhat compile",
    "test": "npx hardhat test",
    "deploy:sepolia": "npx hardhat run scripts/deploy.ts --network base-sepolia",
    "deploy:mainnet": "npx hardhat run scripts/deploy.ts --network base-mainnet",
    "verify:sepolia": "npx hardhat run scripts/verify.ts --network base-sepolia",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.3.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.5.0",
    "hardhat": "^2.22.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
